<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Mau jalan sama aku?</title>
  <style>
    /* ===== CSS: mengatur tampilan ===== */
    body {
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #f093fb, #f5576c);
      min-height: 100vh;
      margin: 0;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .kartu {
      background: white;
      padding: 28px;
      border-radius: 16px;
      width: 90%;
      max-width: 380px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
      text-align: center;
    }
    .arena {
      position: relative;
      height: 220px;
      margin-top: 10px;
    }
    .arena button {
      position: absolute;
      padding: 12px 24px;
      border: none;
      border-radius: 10px;
      color: white;
      font-size: 18px;
      cursor: pointer;
    }
    .ya {
      background: #e91e63;
      left: 12%;
      top: 90px;
      transition: transform 0.3s;
    }
    .ya:hover { background: #c2185b; }
    .tidak {
      background: #888;
      left: 62%;
      top: 90px;
      transition: left 0.2s, top 0.2s;
    }
    .hasil {
      font-weight: bold;
      font-size: 18px;
      min-height: 24px;
      margin-top: 10px;
      color: #e91e63;
    }
  </style>
</head>
<body>

  <!-- ===== HTML: kerangka halaman ===== -->
  <div class="kartu">
    <h2>Mau jalan sama aku? 🚶‍♀️🚶</h2>

    <div class="arena" id="arena">
      <button class="ya" id="tombolYa" onclick="jawabYa()">Ya 💖</button>
      <button class="tidak" id="tombolTidak">Tidak</button>
    </div>

    <p id="hasil" class="hasil"></p>
  </div>

  <!-- ===== JavaScript: membuat halaman interaktif ===== -->
  <script>
    let tombolTidak = document.getElementById("tombolTidak");
    let tombolYa = document.getElementById("tombolYa");
    let arena = document.getElementById("arena");
    let jumlahKabur = 0;

    // Teks tombol "Tidak" berubah-ubah tiap kabur
    let teksTidak = ["Tidak", "Yakin?", "Coba lagi", "Eh kok kabur", "Ayolah 🥺", "Gak bisa 😜", "Hehe 😆"];

    function kabur() {
      let lebarMax = arena.clientWidth - tombolTidak.offsetWidth;
      let tinggiMax = arena.clientHeight - tombolTidak.offsetHeight;
      let rectYa = tombolYa.getBoundingClientRect();
      let rectArena = arena.getBoundingClientRect();

      // Cari posisi acak yang TIDAK menutupi tombol "Ya"
      let x, y;
      for (let percobaan = 0; percobaan < 30; percobaan++) {
        x = Math.random() * lebarMax;
        y = Math.random() * tinggiMax;

        let kiri = rectArena.left + x;
        let atas = rectArena.top + y;
        let menabrak =
          kiri < rectYa.right + 10 &&
          kiri + tombolTidak.offsetWidth > rectYa.left - 10 &&
          atas < rectYa.bottom + 10 &&
          atas + tombolTidak.offsetHeight > rectYa.top - 10;

        if (!menabrak) { break; }
      }

      tombolTidak.style.left = x + "px";
      tombolTidak.style.top = y + "px";

      jumlahKabur = jumlahKabur + 1;
      tombolTidak.innerText = teksTidak[jumlahKabur % teksTidak.length];

      // Tombol "Ya" makin besar tiap "Tidak" kabur (maksimal 1.5x)
      tombolYa.style.transform = "scale(" + Math.min(1 + jumlahKabur * 0.05, 1.5) + ")";
    }

    // Kabur saat kursor mendekat (komputer) atau jari menyentuh (HP)
    tombolTidak.addEventListener("mouseover", kabur);
    tombolTidak.addEventListener("touchstart", function (e) {
      e.preventDefault();
      kabur();
    });
    tombolTidak.addEventListener("click", kabur); // cadangan, misalnya lewat keyboard

    function jawabYa() {
      document.getElementById("hasil").innerText = "Yeay! Sampai ketemu ya 🥰🎉";
      tombolTidak.style.display = "none";
    }
  </script>
</body>
</html>
